/*
 * PandaKB Forager, 34 keys (3x5+2) — ZMK.
 * Ported from mbastar/zmk-keyboard-toucan2 @ 4195c28 (config/toucan.keymap).
 *
 * Why this port is NOT free, unlike Corne Mini -> Toucan2: those are 42-slot
 * arrays with dead outer columns. The Forager is a true 34-slot array, so every
 * position number changes (Toucan 12r+c -> Forager 10r+c-1; thumbs 37-40 ->
 * 30-33). Bindings and hold-tap tuning carry over unchanged; every combo and
 * every hold-trigger-key-positions list was renumbered.
 *
 * Thumbs: the Toucan's four inner thumbs, unchanged —
 *   ENT | ESC/NAV || BSPC/SYM | SPC
 * The two outer thumbs are gone: TAB moved to the Q+W combo; DEL stays on the
 * C+V combo and on NAV/SYM. The ARROW layer was a trial and was not ported.
 * No trackpad, so no TOUCH layer and no mouse keys.
 *
 * HRM TUNING LOG: internal-systems/infrastructure/keyboards/toucan2/hrm-tuning.md
 *   in the vault — the verified hold-tap model, the tests, and what is deferred.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEF   0
#define NAV   1
#define SYM   2
#define ADJ   3


/* Layer-taps sit on ESC and BSPC, which you sometimes want to hold to repeat.
   quick-tap-ms restores that: tap, then press-and-hold again within 200 ms and
   it repeats the tap instead of entering the layer.
   require-prior-idle-ms (2026-09-10): SYM sits on Backspace, which is pressed
   mid-typing constantly. With no idle guard the stock flavor commits to the
   layer on the next keypress and types a symbol instead of a letter. 100 ms =
   no layer inside a typing roll, still instant after any pause. */
&lt { quick-tap-ms = <200>; require-prior-idle-ms = <100>; };

/* 34-slot matrix, no dead positions.
   Left:  0-4   10-14  20-24  thumbs 30 31
   Right: 5-9   15-19  25-29  thumbs 32 33 */

#define LEFT_KEYS   0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define RIGHT_KEYS  5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define LEFT_THUMB  30 31
#define RIGHT_THUMB 32 33

/ {
    behaviors {
        /* Home-row mods. Cross-hand only: a left-hand mod fires only if a RIGHT-hand
           key follows, which is what stops "df" turning into ctrl+d.

           Three tiers, tuned by how often the TAP character is typed -- not by
           which finger it is. Misfire risk scales with tap frequency; the cost of
           a hard hold scales with how often you need the mod. */

        /* Index (F J -> SHIFT; Ctrl split out to hmlc/hmrc 2026-09-28). Pressed mid-roll, so the hold
           has to be easy to get: shorter term, prior-idle 80 rather than 150
           because that guard was eating Shift right after a letter -- the
           "f/ instead of ?" failure. */
        hmli: home_row_mod_left_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <RIGHT_KEYS RIGHT_THUMB>;
            hold-trigger-on-release;
        };

        hmri: home_row_mod_right_index {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <80>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <LEFT_KEYS LEFT_THUMB>;
            hold-trigger-on-release;
        };

        /* Middle (D K -> CTRL), split out of hmli/hmri 2026-09-28. Balanced +
           hold-trigger-on-release has a release path: a cross-hand key pressed
           AND released while D is still down is a hold, whatever the term -- a
           lingering "do" became Ctrl-O. tap-preferred has no such path; Ctrl
           engages only when the term expires. Cost: every Ctrl (C-c, C-o, C-r)
           is a deliberate 200 ms hold. prior-idle 150 keeps D/K a plain tap
           inside a typing roll. Positional kept: moot for tap-preferred, harmless. */
        hmlc: home_row_mod_left_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <RIGHT_KEYS RIGHT_THUMB>;
            hold-trigger-on-release;
        };

        hmrc: home_row_mod_right_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <LEFT_KEYS LEFT_THUMB>;
            hold-trigger-on-release;
        };

        /* Ring + pinky (S ' -> ALT, GUI; L split out to hmra 2026-09-28). ALT stays fast because
           option-arrow and option-backspace are mid-flow editing gestures;
           ' stays fast because it is the only source of Cmd for every
           left-hand letter.

           2026-09-10: hml term 280 -> 350. For a balanced cross-hand mod the
           term only governs same-hand and solo holds -- the intended cross-hand
           chords resolve on interrupt and never see it. Word-initial "se" after
           a pause was crossing 280 ms before E released and firing Opt-E (the
           ´ dead key). hmr stays at 280 on purpose: L+E is cross-hand, so a
           longer term cannot help it, and ' is almost never solo-held. */
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <350>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <RIGHT_KEYS RIGHT_THUMB>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <LEFT_KEYS LEFT_THUMB>;
            hold-trigger-on-release;
        };

        /* Right ring (L -> ALT), split out of hmr 2026-09-28 -- the same release
           path: "li" -> Opt-I (ˆ), "le" -> Opt-E (´). tap-preferred, so a
           right-hand Alt is a deliberate 200 ms hold. ' stays on balanced hmr:
           '+V is the designed fast paste. */
        hmra: home_row_mod_right_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <LEFT_KEYS LEFT_THUMB>;
            hold-trigger-on-release;
        };

        /* Left pinky only (A -> GUI). tap-preferred resolves as HOLD only when the
           term actually expires, no matter what else is pressed -- so "an",
           "and", "man", "a " can no longer become Cmd-N or Cmd-Space. 'a' is ~8%
           of English letters, which is why this key needs the guard; ' is under
           0.3%, which is why the right pinky does not.

           2026-09-10 retune: the timer is this key's ONLY hold path, so the
           term is felt on every Cmd -- 200 not 280. require-prior-idle-ms
           150 -> 0: it turned A into an instant tap whenever paste followed
           typing ("xxav"), and tap-preferred already does the roll protection
           it was there for. Verified on the board: hold A past the term, tap V
           any time -> paste; positional does not downgrade a timer-decided
           hold. New exposure: an 'a' held 200 ms+ with any key pressed is Cmd.

           2026-09-11 round 2: that exposure fired in the wild -- hesitation
           on 'a' became Cmd. One change per the round cadence: term 200 -> 230.
           Every deliberate Cmd now takes 230 ms; nothing else moved. */
        hmlp: home_row_mod_left_pinky {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <230>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <0>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <RIGHT_KEYS RIGHT_THUMB>;
            hold-trigger-on-release;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS UNDERSCORE BACKSPACE>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
            layers = <DEF NAV>;
            require-prior-idle-ms = <150>;
        }; /* Q + W -> TAB (replaces the Toucan's outer left thumb). "qw" is in
              no English word; the idle guard stops it firing inside a typing
              roll. Cmd-Tab: hold Cmd on the RIGHT pinky (') -- cross-hand, so
              the HRM resolves normally. Active on NAV too, so NAV + A (plain
              Cmd) + Q+W is a fallback route. */
        screenshot {
            bindings = <&kp LG(LS(N4))>;
            key-positions = <0 20>;
            layers = <DEF>;
        }; /* Q + Z */
        dictation {
            bindings = <&kp F13>;
            key-positions = <27 28>;
            layers = <DEF>;
        }; /* , + . -> F13 (Raycast dictation). Deliberately not right-GUI:
              VoiceInk listens for a bare right-GUI tap, so every cross-hand Cmd
              from the `'` home-row mod flashed the dictation window. */
        lpar {
            bindings = <&kp LPAR>;
            key-positions = <3 4>;
            layers = <DEF>;
        }; /* R + T */
        rpar {
            bindings = <&kp RPAR>;
            key-positions = <5 6>;
            layers = <DEF>;
        }; /* Y + U */
        lbkt {
            bindings = <&kp LBKT>;
            key-positions = <13 14>;
            layers = <DEF>;
        }; /* F + G */
        rbkt {
            bindings = <&kp RBKT>;
            key-positions = <15 16>;
            layers = <DEF>;
        }; /* H + J */
        lbrc {
            bindings = <&kp LBRC>;
            key-positions = <23 24>;
            layers = <DEF>;
        }; /* V + B */
        rbrc {
            bindings = <&kp RBRC>;
            key-positions = <25 26>;
            layers = <DEF>;
        }; /* N + M */

        capsword {
            bindings = <&caps>;
            key-positions = <13 16>;
        };  /* F + J -> caps word */
        plus {
            bindings = <&kp PLUS>;
            key-positions = <13 14>;
            layers = <SYM>;
        };  /* SYM: - and = together -> +. Scoped to SYM so F+G on base is
               still `[`. Known risk: typing `-=` fast; fix is timeout-ms. */
        del {
            bindings = <&kp DEL>;
            key-positions = <22 23>;
        };  /* C + V -> DEL. "cv" is in no English word. */
    };

    keymap {
        compatible = "zmk,keymap";

        DEF {
            display-name = "Base";

            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  '  |  home-row mods
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  |
            //                   | ENT | ESC/NAV |   | BSPC/SYM | SPC |
            //   combos: Q+W TAB · C+V DEL · F+J caps word

            bindings = <
&kp Q         &kp W        &kp E          &kp R          &kp T          &kp Y         &kp U          &kp I          &kp O         &kp P
&hmlp LGUI A  &hml LALT S  &hmlc LCTRL D  &hmli LSHFT F  &kp G          &kp H         &hmri RSHFT J  &hmrc RCTRL K  &hmra RALT L  &hmr RGUI SQT
&kp Z         &kp X        &kp C          &kp V          &kp B          &kp N         &kp M          &kp COMMA      &kp DOT       &kp FSLH
                                          &kp RET        &lt NAV ESC    &lt SYM BSPC  &kp SPACE
            >;
        };

        NAV {
            display-name = "Nav/Num";

            // |  1  |  2  |  3  |  4  |  5  |   |  6  |  7   |  8   |  9  |  0  |
            // | GUI | ALT | CTL | SFT |     |   |  <- |  v   |  ^   |  -> | END |
            // |     |     |     |     |     |   | PGUP| PGDN | HOME |     | DEL |

            bindings = <
&kp N1    &kp N2    &kp N3     &kp N4     &kp N5    &kp N6     &kp N7     &kp N8    &kp N9     &kp N0
&kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &kp END
&trans    &trans    &trans     &trans     &trans    &kp PG_UP  &kp PG_DN  &kp HOME  &trans     &kp DEL
                               &trans     &trans    &trans     &trans
            >;
        };

        SYM {
            display-name = "Sym/Fn";

            // |  !  |  @  |  #  |  $  |  %  |   | F7 | F8 | F9 | F10 |  :  |
            // |  ^  |  &  |  *  |  -  |  =  |   | F4 | F5 | F6 | F11 |  ;  |
            // |  _  |  `  |  ~  |  \  | "|" |   | F1 | F2 | F3 | F12 | DEL |
            //   combo: - + =  ->  +

            bindings = <
&kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT    &kp F7  &kp F8  &kp F9  &kp F10  &kp COLON
&kp CARET  &kp AMPS   &kp ASTRK  &kp MINUS  &kp EQUAL    &kp F4  &kp F5  &kp F6  &kp F11  &kp SEMI
&kp UNDER  &kp GRAVE  &kp TILDE  &kp BSLH   &kp PIPE     &kp F1  &kp F2  &kp F3  &kp F12  &kp DEL
                                 &trans     &trans       &trans  &trans
            >;
        };

        ADJ {
            display-name = "System";

            // reached by holding NAV + SYM together (conditional layer)
            // |     |     |     |     |        |   |     |     |     |      |      |
            // | BT0 | BT1 | BT2 |BTCLR| STUDIO |   | USB | BLE |     |      |      |
            // | BOOT|RESET|     |     |BTCLRA  |   |     |     |     |RESET | BOOT |
            //
            // BT0 (A) = Mac Studio, BT1 (S) = MacBook Air. Studio differs from the other
            // boards (D there); the Air key matches.
            // &bootloader / &sys_reset are SOURCE-SPECIFIC on a split: each only
            // affects the half it is physically pressed on, so both halves need
            // their own. Studio locking is off in this module (forager_left.conf),
            // so &studio_unlock is belt-and-braces, not required.

            bindings = <
&trans        &trans        &trans        &trans      &trans            &trans         &trans         &trans  &trans      &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &studio_unlock    &out OUT_USB   &out OUT_BLE   &trans  &trans      &trans
&bootloader   &sys_reset    &trans        &trans      &bt BT_CLR_ALL    &trans         &trans         &trans  &sys_reset  &bootloader
                                          &trans      &trans            &trans         &trans
            >;
        };

        /* Empty slots so ZMK Studio can hand out extra layers with no rebuild. */

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
